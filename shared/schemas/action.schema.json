{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bergamot action manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "enabled", "platforms", "matching", "executor", "output"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
    "label": { "$ref": "#/definitions/nonEmptyString" },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "enabled": { "type": "boolean" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["macos", "windows", "linux"] }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions", "cardinality"],
      "properties": {
        "extensions": {
          "oneOf": [
            { "const": ["*"] },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/extension" }
            }
          ]
        },
        "cardinality": { "enum": ["single", "each", "batch"] }
      }
    },
    "executor": {
      "oneOf": [
        { "$ref": "#/definitions/process" },
        { "$ref": "#/definitions/script" },
        { "$ref": "#/definitions/webhook" }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "file", "clipboard", "stdout"] },
        "extension": { "$ref": "#/definitions/extension" },
        "suffix": { "type": "string", "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001f]*$" },
        "overwriteOriginal": { "type": "boolean", "default": false }
      }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "extension": { "type": "string", "pattern": "^[\\p{Ll}\\p{Lm}\\p{Lo}\\p{Nd}][\\p{Ll}\\p{Lm}\\p{Lo}\\p{Nd}\\p{M}_+-]*$" },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 4294967295, "default": 60 },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "program"],
      "properties": {
        "type": { "const": "process" },
        "program": { "$ref": "#/definitions/nonEmptyString" },
        "args": { "type": "array", "items": { "type": "string" }, "default": [] },
        "workingDirectory": { "$ref": "#/definitions/nonEmptyString" },
        "env": { "$ref": "#/definitions/stringMap" },
        "timeoutSeconds": { "$ref": "#/definitions/timeout" }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "interpreter"],
      "properties": {
        "type": { "const": "script" },
        "interpreter": { "$ref": "#/definitions/nonEmptyString" },
        "scriptBody": { "$ref": "#/definitions/nonEmptyString" },
        "scriptPath": { "$ref": "#/definitions/nonEmptyString" },
        "timeoutSeconds": { "$ref": "#/definitions/timeout" }
      },
      "oneOf": [{ "required": ["scriptBody"] }, { "required": ["scriptPath"] }]
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "method", "url"],
      "properties": {
        "type": { "const": "webhook" },
        "method": { "type": "string", "pattern": "^[A-Z][A-Z0-9!#$%&'*+.^_`|~\\-]*$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "headers": { "$ref": "#/definitions/stringMap" },
        "fileFieldName": { "$ref": "#/definitions/nonEmptyString" },
        "credentialKey": { "$ref": "#/definitions/nonEmptyString" },
        "timeoutSeconds": { "$ref": "#/definitions/timeout" }
      }
    }
  }
}
