{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bergamotto",
  "version": "0.0.1-alpha",
  "identifier": "io.github.cydoniancitizen.bergamotto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "wheel", "url": "index.html#/wheel", "title": "Radial Wheel",
        "width": 420, "height": 420, "resizable": false, "visible": false,
        "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "shadow": false
      },
      {
        "label": "hud", "url": "index.html#/hud", "title": "Job Progress",
        "width": 420, "height": 100, "focus": false, "focusable": false, "resizable": false, "visible": false,
        "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "shadow": false
      },
      {
        "label": "studio", "url": "index.html#/studio", "title": "Bergamotto — Action Studio",
        "width": 1080, "height": 740, "minWidth": 700, "minHeight": 540, "visible": false, "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Radial action launcher for rapid file workflows",
    "longDescription": "Bergamotto is a cross-platform radial action launcher inspired by Tangerine for rapid, zero-friction file workflows.",
    "copyright": "Copyright © 2026 Thomas and contributors",
    "category": "Utility",
    "windows": {
      "wix": {
        "version": "0.0.1"
      }
    }
  }
}
